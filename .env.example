PORT=8888
VITE_PORT=6996
HOST=localhost
SESSION_STORAGE=memory
SESSION_MEMORY_COUNT=10000
DB_FILE_NAME=data/mydb.sqlite
# Optional: the browser uses its own origin, SSR uses http://localhost:$PORT
PUBLIC_API_URL=http://localhost:8888
PUBLIC_WS_URL=ws://localhost:8888/ws
LOG_LEVEL=error
# Comma-separated origins allowed to call the API cross-site (empty: none)
CORS_ORIGIN=
# Login/register attempts per IP per minute
AUTH_RATE_LIMIT=10
