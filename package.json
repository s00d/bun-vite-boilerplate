{
  "name": "bun-vite-boilerplate",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build:client": "bun x vite build",
    "build:ssr": "bun x vite build --mode ssr",
    "build": "bun run build:client && bun run build:ssr",
    "generate": "bun run scripts/generateStaticPages.ts",
    "dev": "cross-env NODE_ENV=development bun --hot run src/server/index.ts",
    "start": "cross-env NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test tests",
    "loadtest:login": "bun run scripts/loadtest.ts",
    "loadtest:homepage": "bun run scripts/homepagetest.ts",
    "artillery:login": "npx artillery run scripts/artillery-login.yml",
    "artillery:homepage": "npx artillery run scripts/artillery-homepage.yml",
    "lint": "oxlint-vue-rs",
    "lint:fix": "oxlint-vue-rs --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@bogeychan/elysia-etag": "^0.1.0",
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/server-timing": "^1.4.1",
    "@elysiajs/static": "^1.4.12",
    "@elysiajs/swagger": "^1.3.1",
    "@i18n-micro/node": "^2.1.1",
    "@i18n-micro/utils": "^2.1.1",
    "@i18n-micro/vue": "^2.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vue/server-renderer": "^3.5.45",
    "@vueuse/head": "^2.0.0",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "elysia-rate-limit": "^4.6.3",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "autocannon": "^9.0.0",
    "better-sqlite3": "^13.2.0",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-vue-rs": "^0.1.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
